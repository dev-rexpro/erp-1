VITE_CLERK_PUBLISHABLE_KEY=

# ==========================================
# SNOWFLAKE DATA CLOUD & CORTEX AI CONFIG
# ==========================================
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=FDRM
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=
